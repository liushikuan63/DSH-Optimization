{
  "format": "dsh-bundle",
  "name": "@local/ultimate-model",
  "version": "1.4.3-review.7",
  "preset": "ultimate-model",
  "requires": {
    "dsh": ">=0.2.1-rc.2 <0.2.2-0"
  },
  "capabilityLayers": {
    "kernel": "preset/skills/jizhi-mode/SKILL.md",
    "metadataSearch": "scripts/skill-load.mjs",
    "references": "preset/skills/jizhi-mode/references",
    "templates": "preset/skills/jizhi-mode/templates",
    "officialCordisRoutes": [
      "agent-experience",
      "cordis-plugin-development",
      "editing-cordis-compositions",
      "cordis-composition-reference"
    ],
    "toolNamespaces": [
      "cordis_inspect",
      "plugin"
    ],
    "contextProtocol": "request-json-v1"
  },
  "mutatesUserHome": false,
  "automaticMcpInstall": false,
  "defaultTimeoutAutoApproval": false,
  "notes": [
    "Install and remove with plugin_manager only.",
    "Legacy apply/uninstall file rewriting is refused.",
    "Hooks and optional MCP examples are not proof of active registration."
  ]
}
